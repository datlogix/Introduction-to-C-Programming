# A minimal Makefile -- just enough to stop retyping the gcc command.
#
# Run it by typing "make" in this folder. "make" reads the target named
# "all" below (the default target) and runs the recipe line under it.
#
# IMPORTANT: the indented line under "all:" MUST start with a real TAB
# character, not spaces -- this is one of the few places in C-adjacent
# tooling where whitespace matters. Most editors will do this
# automatically inside a file named exactly "Makefile".
all:
	gcc main.c stats.c -o program

clean:
	rm -f program
